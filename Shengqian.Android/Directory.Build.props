<Project>
 <ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Src\Resources\AppIcon\appicon.svg" ForegroundFile="Src\Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Src\Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Src\Resources\Images\*" />
		<MauiImage Update="Src\Resources\Images\dotnet_bot.png" BaseSize="222,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Src\Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Src\Resources\Raw" prefix) -->
		<MauiAsset Include="Src\Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- XAML pages (source generator only runs on MauiXaml items) -->
		<MauiXaml Include="Src\**\*.xaml" />
	</ItemGroup>
</Project>