<ContentPage x:Class="Shengqian.Android.MainPage"
             xmlns:controls="clr-namespace:Shengqian.Android.Controls"
             xmlns:models="clr-namespace:Shengqian.Android.Controls.Models">
    <Grid RowDefinitions="auto, auto, *, auto" RowSpacing="12" Margin="16">
        <CollectionView Grid.Row="0" x:Name="Overview">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CardData">
                    <controls:Card Title="{Binding Title}" Description="{Binding Description}" Detail="{Binding Detail}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border Grid.Row="1"
                Stroke="Navy"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Secondary}">
            <SearchBar Placeholder="Search items..."
                       FontSize="18"
                       BackgroundColor="Transparent" />
        </Border>
        <CollectionView Grid.Row="2" x:Name="CardList">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CardData">
                    <SwipeView>
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem Text="Favorite" IconImageSource="dotnet_bot.png" />
                                <SwipeItem Text="Delete" IconImageSource="dotnet_bot.png" />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <controls:Card Title="{Binding Title}" Description="{Binding Description}" Detail="{Binding Detail}" />
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3"
                Text="Add category"
                BackgroundColor="{ StaticResource Primary }"
                TextColor="{ StaticResource Secondary }"
                FontSize="18"
                CornerRadius="10"
                BorderWidth="2"
                BorderColor="Navy" />
    </Grid>
</ContentPage>
